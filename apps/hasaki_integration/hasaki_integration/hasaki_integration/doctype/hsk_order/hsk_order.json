    },
    {
      "fieldname": "shipping_total",
      "label": "Shipping Total",
      "fieldtype": "Currency",
      "precision": "2",
      "default": "0"
    },
    {
      "fieldname": "guest_full_name",
      "label": "Guest Full Name",
      "fieldtype": "Data"
    },
    {
      "fieldname": "guest_phone",
      "label": "Guest Phone",
      "fieldtype": "Data"
    },
    {
      "fieldname": "guest_email",
      "label": "Guest Email",
      "fieldtype": "Data",
      "options": "Email"
    },
    {
      "fieldname": "items",
      "label": "Items",
      "fieldtype": "Table",
      "options": "HSK Order Item",
      "reqd": 1
    },
    {
      "fieldname": "status_history",
      "label": "Status History",
      "fieldtype": "Table",
      "options": "HSK Order Status History",
      "read_only": 1
    },
    {
      "fieldname": "last_source_modified_at",
      "label": "Last Source Modified At",
